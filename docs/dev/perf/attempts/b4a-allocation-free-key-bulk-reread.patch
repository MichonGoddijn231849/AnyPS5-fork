+std::size_t ShaderMemory::readRun(void* context, std::uint64_t address, const ShaderRecompiler::SrtMemoryWord* expected, ShaderRecompiler::SrtMemoryWord* results, std::size_t count) {
+    auto& self = *static_cast<ShaderMemory*>(context);
+    constexpr auto WordBytes = static_cast<std::uint64_t>(sizeof(std::uint32_t));
+    // Misaligned or wrapping addresses, and dwords in or next to a snapshot region, take read's own
+    // checks, so they are read one at a time by read.
+    const bool plain = address % WordBytes == 0 && count <= (std::numeric_limits<std::uint64_t>::max() - address) / WordBytes && clearOfInitial(self.initial, address, address + count * WordBytes);
+    const auto readOne = [&](std::uint64_t at) {
+        std::uint32_t value = 0;
+        const bool ok = read(context, at, &value);
+        return ShaderRecompiler::SrtMemoryWord{ok ? value : 0u, ok};
+    };
+    std::size_t done = 0;
+    while (done < count) {
+        if (!plain) {
+            results[done] = readOne(address + done * WordBytes);
+            if (!ShaderRecompiler::SameMemoryWord(results[done], expected[done])) return done + 1;
+            ++done;
+            continue;
+        }
+        // One page lookup for the page of the next word, then the words of that page in order.
+        const auto base = (address + done * WordBytes) & ~static_cast<std::uint64_t>(PageBytes - 1);
+        auto& page = self.page(base);
+        for (; done < count && address + done * WordBytes - base < PageBytes; ++done) {
+            const auto wordAddress = address + done * WordBytes;
+            const auto index = static_cast<std::size_t>((wordAddress % PageBytes) / WordBytes);
+            if (page.valid.Test(index)) {
+                // read's path for a valid dword: counted, marked read and recent, and its value returned.
+                ++CaptureTotals().reads;
+                page.read.Set(index);
+                page.recent.Set(index);
+                results[done] = {page.words[index], true};
+            } else {
+                results[done] = readOne(wordAddress);
+            }
+            if (!ShaderRecompiler::SameMemoryWord(results[done], expected[done])) return done + 1;
+        }
+    }
+    return count;
+}
